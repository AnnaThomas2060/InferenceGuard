# Environment variable template for InferenceGuard production deployment.
# Copy this file to .env and configure secret keys and model identifiers.
# Values control serving ports, hardware selection, and Hugging Face tokens.

PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
DEVICE=cpu

# Hugging Face Model Repositories
RISK_MODEL_ID=roberta-base
REWRITER_MODEL_ID=AT707/inferenceguard-rewriter-v1

# Hugging Face Authentication Token
HF_TOKEN=your_huggingface_write_token_here
